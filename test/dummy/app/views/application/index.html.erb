<div class="container-fluid text-white min-vh-100 homepage-landing">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">

      <!-- Hero -->
      <div class="hero pt-3 pb-4 text-center">
        <a href="https://github.com/Lato-org/lato" class="hero-badge hero-badge-oss d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2 mb-4 text-decoration-none llm-ignore">
          <i class="bi bi-unlock-fill" aria-hidden="true"></i>
          <span class="fw-semibold text-nowrap">100% open source</span>
          <span class="hero-badge-sep" aria-hidden="true"></span>
          <span class="text-nowrap">MIT license<span class="d-none d-sm-inline">, free forever</span></span>
        </a>
        <h1 class="display-3 fw-bold mb-4 llm-ignore">Build your next panel<br>with <span class="text-gradient-light">Lato</span></h1>
        <p class="lead fs-4 mb-5 text-white-50 mx-auto hero-lead llm-ignore">
          A <strong class="text-white">Rails Engine</strong> that gives you a complete <strong class="text-white">web application starter kit</strong>:
          authentication, user management and UI components, ready in minutes.
        </p>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mb-5 llm-ignore">
          <%= link_to tutorial_path, class: 'btn btn-light btn-lg px-5 fw-semibold' do %>Get started <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i><% end %>
          <a class="btn btn-outline-light btn-lg px-5" href="https://github.com/Lato-org/lato"><i class="bi bi-github me-1" aria-hidden="true"></i> View on GitHub</a>
        </div>

        <ul class="hero-proof list-unstyled d-flex flex-wrap justify-content-center gap-4 mb-5 small text-white-50 llm-ignore">
          <li><i class="bi bi-heart" aria-hidden="true"></i> No paid tiers, no lock-in</li>
          <li><i class="bi bi-shield-check" aria-hidden="true"></i> MFA and passkeys built in</li>
          <li><i class="bi bi-universal-access" aria-hidden="true"></i> WCAG 2.2 AA audited</li>
          <li><i class="bi bi-translate" aria-hidden="true"></i> 4 languages</li>
          <li><i class="bi bi-puzzle" aria-hidden="true"></i> 5 official engines</li>
        </ul>

        <div class="screenshot-frame hero-frame mx-auto llm-ignore">
          <div class="browser-bar d-flex align-items-center gap-2 px-3 py-2">
            <span class="browser-dot" style="background:#ff5f57"></span>
            <span class="browser-dot" style="background:#febc2e"></span>
            <span class="browser-dot" style="background:#28c840"></span>
          </div>
          <img src="/preview.gif" alt="Lato preview" class="w-100 d-block">
        </div>
      </div>

      <!-- Features -->
      <section class="py-5" aria-labelledby="features-title">
        <div class="text-center mb-5">
          <div class="section-eyebrow mb-2 llm-ignore">Features</div>
          <h2 id="features-title" class="display-6 fw-bold mb-3">Everything you need to launch.<br><span class="text-gradient-light">Nothing you have to rebuild.</span></h2>
          <p class="lead text-white-50 mx-auto section-lead llm-ignore">Stop writing the same login, account page and data table for every project. Lato gives you the foundation, you focus on what makes your product unique.</p>
        </div>

        <div class="row g-4">
          <div class="col-md-6 col-lg-4">
            <div class="glass-card glass-card-link h-100 p-4">
              <div class="feature-icon mb-3 llm-ignore"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
              <h3 class="h5 fw-bold">User Management</h3>
              <p class="text-white-50 mb-0">Full authentication system with signin, signup, password recovery, email validation, Google Authenticator and WebAuthn (passkeys) MFA, and ETH wallet connection.</p>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="glass-card glass-card-link h-100 p-4">
              <div class="feature-icon mb-3 llm-ignore"><i class="bi bi-columns-gap" aria-hidden="true"></i></div>
              <h3 class="h5 fw-bold">Modern UI</h3>
              <p class="text-white-50 mb-0">Web interface built with Bootstrap and Bootstrap Icons, featuring integrated UI components like data tables, forms, and modals.</p>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="glass-card glass-card-link h-100 p-4">
              <div class="feature-icon mb-3 llm-ignore"><i class="bi bi-gear" aria-hidden="true"></i></div>
              <h3 class="h5 fw-bold">Stack Agnostic</h3>
              <p class="text-white-50 mb-0">Works with different databases (PostgreSQL, MySQL, SQLite), job processors (Solid queue, Sidekiq, Delayed Job), and cache systems.</p>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="glass-card glass-card-link h-100 p-4">
              <div class="feature-icon mb-3 llm-ignore"><i class="bi bi-palette" aria-hidden="true"></i></div>
              <h3 class="h5 fw-bold">Customizable &amp; Extendable</h3>
              <p class="text-white-50 mb-0">The gem is designed to be easily customizable and extendable. You can fully customize the UI and functionalities, add new features to your main application, or develop new engines to extend the panel.</p>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="glass-card glass-card-link h-100 p-4">
              <div class="feature-icon mb-3 llm-ignore"><i class="bi bi-rocket-takeoff" aria-hidden="true"></i></div>
              <h3 class="h5 fw-bold">Modern Rails Features</h3>
              <p class="text-white-50 mb-0">Ready to use with Rails 8.1 (&gt;= 8.1.3.1, &lt; 8.2) features like ESM import maps, Turbo and Stimulus. The front-end is responsive and mobile friendly.</p>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="glass-card glass-card-link h-100 p-4">
              <div class="feature-icon mb-3 llm-ignore"><i class="bi bi-universal-access" aria-hidden="true"></i></div>
              <h3 class="h5 fw-bold">Accessible by Design</h3>
              <p class="text-white-50 mb-0">Keyboard friendly, screen reader aware components audited with axe-core against WCAG 2.2 AA rules. Accessibility comes built in, not as an afterthought.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Screenshots -->
      <section class="py-5 llm-ignore" aria-labelledby="showcase-title">
        <div class="text-center mb-4">
          <div class="section-eyebrow mb-2">Showcase</div>
          <h2 id="showcase-title" class="display-6 fw-bold mb-3">See it in action</h2>
          <p class="lead text-white-50 mx-auto section-lead">Data tables, forms and account management, ready on day one.</p>
        </div>

        <ul class="nav nav-pills showcase-tabs justify-content-center flex-wrap gap-2 mb-4" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="showcase-tab-tables" data-bs-toggle="pill" data-bs-target="#showcase-tables" type="button" role="tab" aria-controls="showcase-tables" aria-selected="true"><i class="bi bi-table me-1" aria-hidden="true"></i> Data tables</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="showcase-tab-forms" data-bs-toggle="pill" data-bs-target="#showcase-forms" type="button" role="tab" aria-controls="showcase-forms" aria-selected="false"><i class="bi bi-ui-checks me-1" aria-hidden="true"></i> Forms</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="showcase-tab-account" data-bs-toggle="pill" data-bs-target="#showcase-account" type="button" role="tab" aria-controls="showcase-account" aria-selected="false"><i class="bi bi-person-gear me-1" aria-hidden="true"></i> Account</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="showcase-tab-auth" data-bs-toggle="pill" data-bs-target="#showcase-auth" type="button" role="tab" aria-controls="showcase-auth" aria-selected="false"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i> Authentication</button>
          </li>
        </ul>

        <div class="tab-content">
          <div class="tab-pane fade show active" id="showcase-tables" role="tabpanel" aria-labelledby="showcase-tab-tables" tabindex="0">
            <div class="screenshot-frame mx-auto"><img src="/screenshots/lato-products.jpg" alt="Lato data table component" class="w-100 d-block" loading="lazy"></div>
            <p class="text-center text-white-50 mt-3 mb-0">Index tables with search, sorting, pagination and custom columns</p>
          </div>
          <div class="tab-pane fade" id="showcase-forms" role="tabpanel" aria-labelledby="showcase-tab-forms" tabindex="0">
            <div class="screenshot-frame mx-auto"><img src="/screenshots/lato-product-form.jpg" alt="Lato form components" class="w-100 d-block" loading="lazy"></div>
            <p class="text-center text-white-50 mt-3 mb-0">Forms with advanced inputs: autocomplete, lists, signatures, dropzone</p>
          </div>
          <div class="tab-pane fade" id="showcase-account" role="tabpanel" aria-labelledby="showcase-tab-account" tabindex="0">
            <div class="screenshot-frame mx-auto"><img src="/screenshots/lato-account.jpg" alt="Lato account management" class="w-100 d-block" loading="lazy"></div>
            <p class="text-center text-white-50 mt-3 mb-0">Account management with email verification, password change and MFA</p>
          </div>
          <div class="tab-pane fade" id="showcase-auth" role="tabpanel" aria-labelledby="showcase-tab-auth" tabindex="0">
            <div class="screenshot-frame mx-auto"><img src="/screenshots/lato-signin.jpg" alt="Lato authentication" class="w-100 d-block" loading="lazy"></div>
            <p class="text-center text-white-50 mt-3 mb-0">Complete authentication flow, including Web3 wallet login</p>
          </div>
        </div>
      </section>

      <!-- Accessibility -->
      <section class="a11y-section mb-5 py-5" aria-labelledby="a11y-title">
        <div class="text-center mb-5">
          <div class="hero-badge d-inline-flex align-items-center gap-2 rounded-pill px-3 py-1 mb-3">
            <i class="bi bi-universal-access" aria-hidden="true"></i>
            <span class="small fw-medium">Accessibility</span>
          </div>
          <h2 id="a11y-title" class="display-6 fw-bold mb-3">Accessible panels,<br><span class="text-gradient-light">out of the box</span></h2>
          <p class="lead text-white-50 mx-auto a11y-lead">
            Accessibility is quickly becoming a requirement, not a nice to have: the European Accessibility Act applies to many digital services since June 2025, and public tenders ask for it.
            With Lato, every screen you build already follows accessible patterns, so your team ships features instead of retrofitting them.
          </p>
        </div>

        <!-- Proof numbers -->
        <div class="row g-3 mb-5 text-center">
          <div class="col-6 col-lg-3">
            <div class="glass-card a11y-stat h-100 p-4">
              <div class="a11y-stat-value">0</div>
              <div class="small text-white-50">axe-core violations on WCAG 2.2 AA rules</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="glass-card a11y-stat h-100 p-4">
              <div class="a11y-stat-value">18</div>
              <div class="small text-white-50">pages audited: auth, account, tables, forms, modules</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="glass-card a11y-stat h-100 p-4">
              <div class="a11y-stat-value">24px</div>
              <div class="small text-white-50">minimum target size on every control</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="glass-card a11y-stat h-100 p-4">
              <div class="a11y-stat-value">4</div>
              <div class="small text-white-50">languages included: English, Italian, French, Romanian</div>
            </div>
          </div>
        </div>

        <div class="row g-4 align-items-stretch mb-5">
          <!-- Benefits -->
          <div class="col-lg-6">
            <div class="row g-3">
              <div class="col-sm-6">
                <div class="glass-card glass-card-link h-100 p-4">
                  <div class="a11y-icon mb-3"><i class="bi bi-lightning-charge" aria-hidden="true"></i></div>
                  <h3 class="h6 fw-bold">Ship faster</h3>
                  <p class="small text-white-50 mb-0">No accessibility backlog at the end of the project: forms, tables and modals are accessible from day one.</p>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="glass-card glass-card-link h-100 p-4">
                  <div class="a11y-icon mb-3"><i class="bi bi-people" aria-hidden="true"></i></div>
                  <h3 class="h6 fw-bold">Reach every user</h3>
                  <p class="small text-white-50 mb-0">Keyboard, screen reader, password manager and mobile users get a panel that simply works.</p>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="glass-card glass-card-link h-100 p-4">
                  <div class="a11y-icon mb-3"><i class="bi bi-briefcase" aria-hidden="true"></i></div>
                  <h3 class="h6 fw-bold">Win more deals</h3>
                  <p class="small text-white-50 mb-0">Answer accessibility questions in tenders and security reviews with a measured, documented baseline.</p>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="glass-card glass-card-link h-100 p-4">
                  <div class="a11y-icon mb-3"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
                  <h3 class="h6 fw-bold">Lower the risk</h3>
                  <p class="small text-white-50 mb-0">Start from components tested against WCAG 2.2 AA rules instead of auditing everything yourself.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- What a screen reader hears -->
          <div class="col-lg-6">
            <figure class="glass-card h-100 p-4 mb-0 d-flex flex-column">
              <div class="small text-uppercase fw-semibold text-white-50 mb-3">What your users get</div>
              <div class="a11y-demo" aria-hidden="true">
                <div class="a11y-demo-label">Email</div>
                <div class="a11y-demo-input">mario.rossi@</div>
                <div class="a11y-demo-error"><i class="bi bi-exclamation-circle"></i> Email is not valid</div>
                <div class="a11y-demo-voice mt-4">
                  <i class="bi bi-volume-up"></i>
                  <span>&ldquo;Email, edit text, <strong>invalid entry</strong>. Email is not valid.&rdquo;</span>
                </div>

                <div class="a11y-demo-table mt-4">
                  <span class="fw-semibold">Name</span>
                  <span class="a11y-demo-sort"><i class="bi bi-sort-up"></i></span>
                  <span class="a11y-demo-sort a11y-demo-focus"><i class="bi bi-sort-down"></i></span>
                </div>
                <div class="a11y-demo-voice mt-3">
                  <i class="bi bi-volume-up"></i>
                  <span>&ldquo;Sort by Name descending, <strong>toggle button</strong>, not pressed.&rdquo;</span>
                </div>
              </div>
              <figcaption class="small text-white-50 mt-3 mb-0">
                Labels, error messages and field state are linked, so screen readers announce what went wrong and where. No extra code in your forms.
              </figcaption>
            </figure>
          </div>
        </div>

        <!-- Built-in checklist -->
        <div class="text-center">
          <h3 class="h6 text-uppercase fw-semibold text-white-50 mb-3">Built in, no configuration needed</h3>
          <ul class="list-unstyled d-flex flex-wrap justify-content-center gap-2 mb-4">
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Labelled fields</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Linked error messages</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Keyboard friendly modals</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Focus return</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Skip link</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Sortable tables with aria-sort</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Live region notifications</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Readable badge colors</li>
            <li class="a11y-chip"><i class="bi bi-check2" aria-hidden="true"></i> Autofill and one-time-code hints</li>
          </ul>
          <%= link_to 'See the components', components_path, class: 'btn btn-light px-4 fw-semibold' %>
          <p class="small text-white-50 mt-4 mb-0 mx-auto a11y-lead">
            Automated audits catch many issues but do not prove full WCAG conformance. We recommend manual testing with assistive technologies for your application, especially if you customize colors.
          </p>
        </div>
      </section>

      <!-- Ecosystem -->
      <section class="py-5 llm-ignore" aria-labelledby="ecosystem-title">
        <div class="text-center mb-5">
          <div class="section-eyebrow mb-2">Ecosystem</div>
          <h2 id="ecosystem-title" class="display-6 fw-bold mb-3">Grow with <span class="text-gradient-light">official engines</span></h2>
          <p class="lead text-white-50 mx-auto section-lead">Add only what you need. Every engine plugs into the same panel, permissions and design.</p>
        </div>
        <div class="row g-3">
          <% [
            ['lato_spaces', 'Lato Spaces', 'bi-diagram-3', 'Multi-workspace with invitations and roles'],
            ['lato_settings', 'Lato Settings', 'bi-sliders', 'Typed application settings editable from the UI'],
            ['lato_storage', 'Lato Storage', 'bi-hdd-stack', 'Active Storage dashboard and cleanup'],
            ['lato_users', 'Lato Users', 'bi-people', 'Users, permissions and invitations management'],
            ['lato_cms', 'Lato CMS', 'bi-file-earmark-richtext', 'Pages, templates, media library and translations']
          ].each do |repo, name, icon, description| %>
            <div class="col-md-6 col-lg-4">
              <a href="https://github.com/Lato-org/<%= repo %>" class="text-decoration-none text-white d-block h-100">
                <div class="glass-card glass-card-link h-100 p-4 d-flex gap-3 align-items-start">
                  <div class="feature-icon flex-shrink-0"><i class="bi <%= icon %>" aria-hidden="true"></i></div>
                  <div class="flex-grow-1">
                    <h3 class="h6 fw-bold mb-1"><%= name %></h3>
                    <p class="small text-white-50 mb-0"><%= description %></p>
                  </div>
                  <i class="bi bi-arrow-up-right text-white-50" aria-hidden="true"></i>
                </div>
              </a>
            </div>
          <% end %>
          <div class="col-md-6 col-lg-4">
            <div class="glass-card glass-card-dashed h-100 p-4 d-flex gap-3 align-items-start">
              <div class="feature-icon flex-shrink-0"><i class="bi bi-plus-lg" aria-hidden="true"></i></div>
              <div>
                <h3 class="h6 fw-bold mb-1">Your engine</h3>
                <p class="small text-white-50 mb-0">Build your own module with the same components and conventions.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Installation -->
      <section class="py-5" aria-labelledby="installation-title">
        <div class="text-center mb-5">
          <div class="section-eyebrow mb-2 llm-ignore">Quick start</div>
          <h2 id="installation-title" class="display-6 fw-bold mb-3">Installation</h2>
          <p class="lead text-white-50 mx-auto section-lead llm-ignore">Up and running in a few minutes, in any Rails 8.1 application.</p>
        </div>

        <ol class="install-steps list-unstyled mb-0">
          <li class="install-step">
            <div class="install-step-number llm-ignore" aria-hidden="true">1</div>
            <div class="install-step-body glass-card p-4">
              <h3 class="h5 fw-bold mb-3">Add Dependencies</h3>
              <p class="text-white-50 mb-3">Add required dependencies to your application's Gemfile:</p>
              <div class="code-block mb-3">
                <pre tabindex="0" class="text-light mb-0"><code># Use JavaScript with ESM import maps [https://github.com/rails/importmap-rails]
gem "importmap-rails" # NOTE: Probably already installed in default Rails 8 project

# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails" # NOTE: Probably already installed in default Rails 8 project

# Hotwire's modest JavaScript framework [https://stimulus.hotwired.dev]
gem "stimulus-rails" # NOTE: Probably already installed in default Rails 8 project

# Use Sass to process CSS
gem "sassc-rails"

# Use lato as application panel
gem "lato"</code></pre>
              </div>
              <p class="text-white-50 mb-3">Lato stores rate limits and verification codes in <code>Rails.cache</code>: use a persistent cache shared across processes (Redis, Solid Cache, Memcached). Wallet login (Web3) also requires <code>gem "eth"</code> in your Gemfile.</p>
            </div>
          </li>
          <li class="install-step">
            <div class="install-step-number llm-ignore" aria-hidden="true">2</div>
            <div class="install-step-body glass-card p-4">
              <h3 class="h5 fw-bold mb-3">Configure Asset Manifest</h3>
              <p class="text-white-50 mb-3">If not already present, add <strong>app/assets/config/manifest.js</strong> file with the following content:</p>
              <div class="code-block mb-3">
                <pre tabindex="0" class="text-light mb-0"><code>//= link_tree ../images
//= link_directory ../stylesheets .css
//= link_tree ../../javascript .js
//= link_tree ../../../vendor/javascript .js</code></pre>
              </div>
            </div>
          </li>
          <li class="install-step">
            <div class="install-step-number llm-ignore" aria-hidden="true">3</div>
            <div class="install-step-body glass-card p-4">
              <h3 class="h5 fw-bold mb-3">Install and Setup</h3>
              <p class="text-white-50 mb-3">Install gem and run required tasks:</p>
              <div class="code-block mb-3">
                <pre tabindex="0" class="text-light mb-0"><code>$ bundle
$ rails active_storage:install
$ rails lato:install:application
$ rails lato:install:migrations
$ rails db:migrate</code></pre>
              </div>
            </div>
          </li>
          <li class="install-step">
            <div class="install-step-number llm-ignore" aria-hidden="true">4</div>
            <div class="install-step-body glass-card p-4">
              <h3 class="h5 fw-bold mb-3">Configure Routes</h3>
              <p class="text-white-50 mb-3">Mount lato routes on the <strong>config/routes.rb</strong> file:</p>
              <div class="code-block mb-3">
                <pre tabindex="0" class="text-light mb-0"><code>Rails.application.routes.draw do
  mount Lato::Engine => "/lato"

  # ....
end</code></pre>
              </div>
            </div>
          </li>
          <li class="install-step">
            <div class="install-step-number llm-ignore" aria-hidden="true">5</div>
            <div class="install-step-body glass-card p-4">
              <h3 class="h5 fw-bold mb-3">Import Styles</h3>
              <p class="text-white-50 mb-3">Import Lato Scss on <strong>app/assets/stylesheets/application.scss</strong> file:</p>
              <div class="code-block mb-3">
                <pre tabindex="0" class="text-light mb-0"><code>@import 'lato/application';

// ....</code></pre>
              </div>
            </div>
          </li>
          <li class="install-step">
            <div class="install-step-number llm-ignore" aria-hidden="true">6</div>
            <div class="install-step-body glass-card p-4">
              <h3 class="h5 fw-bold mb-3">Import JavaScript</h3>
              <p class="text-white-50 mb-3">Import Lato Js on <strong>app/javascript/application.js</strong> file:</p>
              <div class="code-block mb-3">
                <pre tabindex="0" class="text-light mb-0"><code>import "lato/application";

// ....</code></pre>
              </div>
            </div>
          </li>
          <li class="install-step">
            <div class="install-step-number llm-ignore" aria-hidden="true">7</div>
            <div class="install-step-body glass-card p-4">
              <h3 class="h5 fw-bold mb-3">Setup I18n</h3>
              <p class="text-white-50 mb-3">Setup I18n on the <strong>config/application.rb</strong> file:</p>
              <div class="code-block mb-3">
                <pre tabindex="0" class="text-light mb-0"><code>module MyApplication
  class Application < Rails::Application
    config.i18n.available_locales = [:it, :en]
    config.i18n.default_locale = :it

    # ...
  end
end</code></pre>
              </div>
              <p class="text-white-50 mb-3">Lato ships translations for <code>it</code>, <code>en</code>, <code>fr</code> and <code>ro</code>. Any key can be overridden in your application locale files. Emails are available in Italian and English (other locales receive English).</p>
            </div>
          </li>
        </ol>
      </section>


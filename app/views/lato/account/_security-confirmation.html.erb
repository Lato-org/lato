<%# Rendered in several account forms on the same page: suffix ids so each label targets its own field. %>
<% password_id = form.field_id(:current_password, form.object_id) %>
<% code_id = form.field_id(:current_authenticator_code, form.object_id) %>
<div class="mb-3" data-controller="lato-account-security" data-lato-account-security-challenge-url-value="<%= lato.account_security_challenge_path %>" data-lato-account-security-webauthn-value="<%= user.webauthn_enabled? && !user.authenticator_enabled? %>">
  <%= form.label :current_password, I18n.t('lato.current_password'), class: "form-label", for: password_id %>
  <%= form.password_field :current_password, id: password_id, class: "form-control", autocomplete: "current-password" %>
  <% if user.authenticator_enabled? %>
    <%= form.label :current_authenticator_code, I18n.t('lato.current_authenticator_code'), class: "form-label mt-2", for: code_id %>
    <%= form.text_field :current_authenticator_code, id: code_id, value: nil, class: "form-control", autocomplete: "one-time-code", inputmode: "numeric" %>
  <% elsif user.webauthn_enabled? %>
    <%= form.hidden_field :current_webauthn_credential, value: nil, data: { lato_account_security_target: "credential" } %>
    <p class="text-muted mt-2"><%= I18n.t('lato.security_key_confirmation_help') %></p>
  <% end %>
  <p class="text-danger mt-2" data-lato-account-security-target="error" role="alert"></p>
</div>

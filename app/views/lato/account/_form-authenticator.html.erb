<% user ||= Lato::User.new %>
<%= turbo_frame_tag 'account_form-authenticator' do %>
  <%= form_with model: user, url: lato.account_update_authenticator_action_path, data: { turbo_frame: '_self', controller: 'lato-form' } do |form| %>
    <%= lato_form_notices class: %w[mb-3] %>
    <%= lato_form_errors user, class: %w[mb-3] %>
    <% if user.authenticator_enabled? %>
      <div class="alert alert-success"><%= I18n.t('lato.account_authenticator_ready_title') %></div>
      <%= render 'lato/account/security-confirmation', form: form, user: user %>
      <%= lato_form_submit form, I18n.t('lato.account_authenticator_disable'), class: %w[btn-danger] %>
    <% elsif session[:pending_authenticator_secret].present? %>
      <div class="text-center mb-3">
        <img class="shadow-sm rounded" alt="Authenticator enrollment QR code" src="<%= user.authenticator_qr_code_base64(secret: session[:pending_authenticator_secret]) %>" />
      </div>
      <%= form.hidden_field :authenticator_command, value: "confirm" %>
      <%= form.label :authenticator_code, "Confirm authenticator code", class: "form-label" %>
      <%= form.text_field :authenticator_code, value: nil, required: true, class: "form-control mb-3", autocomplete: "one-time-code", inputmode: "numeric" %>
      <%= lato_form_submit form, "Confirm", class: %w[btn-primary] %>
    <% else %>
      <div class="alert alert-light"><%= raw I18n.t('lato.account_authenticator_start_description') %></div>
      <%= render 'lato/account/security-confirmation', form: form, user: user %>
      <%= lato_form_submit form, I18n.t('lato.account_authenticator_generate_qr_code'), class: %w[btn-primary] %>
    <% end %>
  <% end %>
<% end %>

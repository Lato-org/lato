          <a class="btn btn-outline-light btn-lg px-5" href="https://github.com/Lato-org/lato"><i class="bi bi-star me-1" aria-hidden="true"></i> Star on GitHub</a>
        </div>
      </section>
    </div>
  </div>
</div>


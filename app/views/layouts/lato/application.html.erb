<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no,interactive-widget=resizes-content">
  <title><%= @layout_page_title.presence || Lato.config.application_title %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <meta name="view-transition" content="same-origin" />

  <% if response.status >= 500 %>
    <meta name="turbo-visit-control" content="reload">
  <% end %>

  <%= render 'layouts/lato/head_content' %>

  <%# Popper UMD build from the popper_js gem (bootstrap dependency): Bootstrap reads it from window.Popper %>
  <%= javascript_include_tag "popper" %>
  
  <%= stylesheet_link_tag Lato.config.assets_stylesheet_entry, media: "all" %>
  <%= javascript_importmap_tags Lato.config.assets_importmap_entry %>
</head>
<body
  class="controller-<%= controller_name %> action-<%= action_name %> <%= @layout_body_classes.join(' ') %> <%= cookies[:lato_aside_hidden] == 'true' ? 'aside-hidden' : '' %>"
  data-controller="lato-action lato-guide"
>
  <a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white" style="z-index: 2100;" href="#main"><%= I18n.t('lato.skip_to_content') %></a>
  <header>
    <%= render 'layouts/lato/navbar' %>
  </header>

  <div class="d-flex">

    <% if @layout_sidebar %>
      <aside>
        <%= render 'layouts/lato/sidebar' %>
      </aside>
    <% end %>

    <main id="main" tabindex="-1" class="<%= @layout_sidebar ? 'layout_sidebar' : '' %>">
      <%= render 'layouts/lato/content' %>
    </main>
  </div>

  <footer>
    <%= render 'layouts/lato/footer' %>
  </footer>

  <% if @layout_sidebar %>
    <%= render 'layouts/lato/aside-opener' %>
  <% end %>
  
  <%= render 'layouts/lato/action' %>
  <%= render 'layouts/lato/confirm' %>
  <%= render 'layouts/lato/feedbacks' %>
  <%= render 'layouts/lato/network' %>

  <%= render 'layouts/lato/foot_content' %>
</body>
</html>

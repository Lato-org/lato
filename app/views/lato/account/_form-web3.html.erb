<%

user ||= Lato::User.new

%>

<%= turbo_frame_tag 'account_form-web3' do %>
  <%= form_with model: user, url: lato.account_update_web3_action_path, data: { turbo_frame: '_self', controller: 'lato-form' } do |form| %>
    <%= lato_form_notices class: %w[mb-3] %>
    <%= lato_form_errors user, class: %w[mb-3] %>
    <%= render 'lato/account/security-confirmation', form: form, user: user if session[:web3_nonce].blank? %>

    <% if user.web3_address %>
      <div class="row">
        <div class="col col-12 mb-3">
          <%= lato_form_item_label form, :web3_address %>
          <div class="input-group">
            <input value="<%= user.web3_address %>" class="form-control" readonly>
            <button
              class="btn btn-outline-success"
              style="pointer-events: none"
              aria-label="<%= I18n.t('lato.connected_wallet') %>"
            ><%= I18n.t('lato.connected_wallet') %></button>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end">
        <%= lato_form_submit form, I18n.t('lato.disconnect_wallet'), class: %w[btn-danger] %>
      </div>
    <% elsif session[:web3_nonce] %>
      <div class="alert alert-light mb-0">
        <h3 class="alert-heading h4" role="status"><%= I18n.t('lato.connecting') %></h3>
        <div class="progress" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
        </div>
      </div>
      
      <div data-controller="lato-web3-sign">
        <span id="account_form-web3__nonce" style="display: none;" data-lato-web3-sign-target="nonce"><%= session[:web3_nonce] %></span>
        <%= form.hidden_field :web3_address, id: 'account_form-web3__input-web3_address', data: { lato_web3_sign_target: 'address' } %>
        <%= form.hidden_field :web3_signed_nonce, id: 'account_form-web3__input-web3_signed_nonce', data: { lato_web3_sign_target: 'signedNonce' } %>
        <%= lato_form_submit form, I18n.t('lato.confirm'), class: %w[btn-primary d-none], id: 'account_form-web3__submit', data: { lato_web3_sign_target: 'submit' } %>
      </div>
    <% else %>
      <div class="alert alert-light mb-0">
        <h3 class="alert-heading h4"><%= I18n.t('lato.account_web3_start_title') %></h3>
        <p>
          <%= raw I18n.t('lato.account_web3_start_description') %>
        </p>
        <p class="mb-0">
          <%= lato_form_submit form, I18n.t('lato.connect_wallet'), class: %w[btn-primary] %>
        </p>
      </div>
    <% end %>
  <% end %>
<% end %>

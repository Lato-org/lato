<div class="container-fluid text-white min-vh-100 homepage-landing">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">

      <!-- Hero -->
      <div class="py-5 text-center">
        <div class="hero-badge d-inline-flex align-items-center gap-2 rounded-pill px-3 py-1 mb-4 llm-ignore">
          <span class="hero-badge-dot rounded-circle"></span>
          <span class="small fw-medium">Open source &middot; MIT license &middot; Rails engine</span>
        </div>
        <h1 class="display-3 fw-bold mb-4 llm-ignore">Build your next panel<br>with <span class="text-gradient-primary">Lato</span></h1>
        <p class="lead fs-4 mb-5 text-white-50 llm-ignore">
          A <strong class="text-white">Rails Engine</strong> that gives you a complete <strong class="text-white">web application starter kit</strong>:
          authentication, user management and UI components, ready in minutes.
        </p>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mb-5 llm-ignore">
          <%= link_to 'Get started with the tutorial', tutorial_path, class: 'btn btn-light btn-lg px-5 fw-semibold' %>
          <a class="btn btn-outline-light btn-lg px-5" href="https://github.com/Lato-org/lato">View on GitHub</a>
        </div>

        <div class="screenshot-frame mx-auto llm-ignore">
          <div class="browser-bar d-flex align-items-center gap-2 px-3 py-2">
            <span class="browser-dot" style="background:#ff5f57"></span>
            <span class="browser-dot" style="background:#febc2e"></span>
            <span class="browser-dot" style="background:#28c840"></span>
          </div>
          <img src="/preview.gif" alt="Lato preview" class="w-100 d-block">
        </div>
      </div>

      <!-- Features -->
      <div class="row">
        <div class="col-12">
          <h2 class="h3 mb-4 text-center">This gem includes:</h2>

          <div class="row g-4 mb-5">
            <div class="col-md-4">
              <div class="card text-white h-100 glass-card">
                <div class="card-body">
                  <div class="fs-2 mb-2 llm-ignore"><i class="bi bi-shield-lock"></i></div>
                  <h5 class="card-title">User Management</h5>
                  <p class="card-text">Full authentication system with signin, signup, password recovery, email validation, Google Authenticator MFA, and ETH wallet connection.</p>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="card text-white h-100 glass-card">
                <div class="card-body">
                  <div class="fs-2 mb-2 llm-ignore"><i class="bi bi-columns-gap"></i></div>
                  <h5 class="card-title">Modern UI</h5>
                  <p class="card-text">Web interface built with Bootstrap and Bootstrap Icons, featuring integrated UI components like data tables, forms, and modals.</p>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="card text-white h-100 glass-card">
                <div class="card-body">
                  <div class="fs-2 mb-2 llm-ignore"><i class="bi bi-gear"></i></div>
                  <h5 class="card-title">Stack Agnostic</h5>
                  <p class="card-text">Works with different databases (PostgreSQL, MySQL, SQLite), job processors (Solid queue, Sidekiq, Delayed Job), and cache systems.</p>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card text-white h-100 glass-card">
                <div class="card-body">
                  <div class="fs-2 mb-2 llm-ignore"><i class="bi bi-palette"></i></div>
                  <h5 class="card-title">Customizable &amp; Extendable</h5>
                  <p class="card-text">The gem is designed to be easily customizable and extendable. You can fully customize the UI and functionalities, add new features to your main application, or develop new engines to extend the panel.</p>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card text-white h-100 glass-card">
                <div class="card-body">
                  <div class="fs-2 mb-2 llm-ignore"><i class="bi bi-rocket-takeoff"></i></div>
                  <h5 class="card-title">Modern Rails Features</h5>
                  <p class="card-text">Ready to use with the latest Rails 7+ features like ESM import maps, Turbo and Stimulus. The front-end is responsive, mobile friendly and accessible.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Screenshots -->
      <div class="row g-4 mb-5 llm-ignore">
        <div class="col-12 text-center">
          <h2 class="h3 mb-1">Everything your panel needs</h2>
          <p class="text-white-50 mb-4">Data tables, forms and account management out of the box.</p>
        </div>
        <div class="col-md-6">
          <div class="screenshot-frame">
            <img src="/screenshots/lato-products.jpg" alt="Lato data table component" class="w-100 d-block" loading="lazy">
          </div>
          <p class="text-center text-white-50 small mt-2 mb-0">Index tables with search, sorting, pagination and custom columns</p>
        </div>
        <div class="col-md-6">
          <div class="screenshot-frame">
            <img src="/screenshots/lato-product-form.jpg" alt="Lato form components" class="w-100 d-block" loading="lazy">
          </div>
          <p class="text-center text-white-50 small mt-2 mb-0">Forms with advanced inputs: autocomplete, lists, signatures, dropzone</p>
        </div>
        <div class="col-md-6">
          <div class="screenshot-frame">
            <img src="/screenshots/lato-account.jpg" alt="Lato account management" class="w-100 d-block" loading="lazy">
          </div>
          <p class="text-center text-white-50 small mt-2 mb-0">Account management with email verification, password change and MFA</p>
        </div>
        <div class="col-md-6">
          <div class="screenshot-frame">
            <img src="/screenshots/lato-signin.jpg" alt="Lato authentication" class="w-100 d-block" loading="lazy">
          </div>
          <p class="text-center text-white-50 small mt-2 mb-0">Complete authentication flow, including Web3 wallet login</p>
        </div>
      </div>

      <!-- Ecosystem -->
      <div class="row mb-5 llm-ignore">
        <div class="col-12 text-center">
          <h2 class="h3 mb-1">An ecosystem of engines</h2>
          <p class="text-white-50 mb-4">Extend the panel with official modules.</p>
        </div>
        <div class="col-12">
          <div class="row g-3">
            <div class="col-md-4 col-lg">
              <a href="https://github.com/Lato-org/lato_spaces" class="text-decoration-none">
                <div class="card text-white h-100 glass-card glass-card-link">
                  <div class="card-body py-3">
                    <h6 class="card-title mb-1">Lato Spaces</h6>
                    <p class="card-text small text-white-50 mb-0">Multi-workspace with invitations and roles</p>
                  </div>
                </div>
              </a>
            </div>
            <div class="col-md-4 col-lg">
              <a href="https://github.com/Lato-org/lato_settings" class="text-decoration-none">
                <div class="card text-white h-100 glass-card glass-card-link">
                  <div class="card-body py-3">
                    <h6 class="card-title mb-1">Lato Settings</h6>
                    <p class="card-text small text-white-50 mb-0">Application settings from the UI</p>
                  </div>
                </div>
              </a>
            </div>
            <div class="col-md-4 col-lg">
              <a href="https://github.com/Lato-org/lato_storage" class="text-decoration-none">
                <div class="card text-white h-100 glass-card glass-card-link">
                  <div class="card-body py-3">
                    <h6 class="card-title mb-1">Lato Storage</h6>
                    <p class="card-text small text-white-50 mb-0">Active Storage management</p>
                  </div>
                </div>
              </a>
            </div>
            <div class="col-md-6 col-lg">
              <a href="https://github.com/Lato-org/lato_users" class="text-decoration-none">
                <div class="card text-white h-100 glass-card glass-card-link">
                  <div class="card-body py-3">
                    <h6 class="card-title mb-1">Lato Users</h6>
                    <p class="card-text small text-white-50 mb-0">Users management from the panel</p>
                  </div>
                </div>
              </a>
            </div>
            <div class="col-md-6 col-lg">
              <a href="https://github.com/Lato-org/lato_cms" class="text-decoration-none">
                <div class="card text-white h-100 glass-card glass-card-link">
                  <div class="card-body py-3">
                    <h6 class="card-title mb-1">Lato CMS</h6>
                    <p class="card-text small text-white-50 mb-0">Web pages management</p>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Installation -->
      <div class="row mb-5">
        <div class="col-12">
          <div class="card text-white glass-card">
            <div class="card-body">
              <h3 class="card-title">Installation</h3>

              <h5 class="mt-4 mb-3">Add Dependencies</h5>
              <p class="card-text mb-3">Add required dependencies to your application's Gemfile:</p>
              <div class="bg-dark p-3 rounded mb-4">
                <pre class="text-light mb-0"><code># Use JavaScript with ESM import maps [https://github.com/rails/importmap-rails]
gem "importmap-rails" # NOTE: Probably already installed in default rails 7+ project

# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails" # NOTE: Probably already installed in default rails 7+ project

# Hotwire's modest JavaScript framework [https://stimulus.hotwired.dev]
gem "stimulus-rails" # NOTE: Probably already installed in default rails 7+ project

# Use Sass to process CSS
gem "sassc-rails"

# Use lato as application panel
gem "lato"</code></pre>
              </div>

              <h5 class="mt-4 mb-3">Configure Asset Manifest</h5>
              <p class="card-text mb-3">If not already present, add <strong>app/assets/config/manifest.js</strong> file with the following content:</p>
              <div class="bg-dark p-3 rounded mb-4">
                <pre class="text-light mb-0"><code>//= link_tree ../images
//= link_directory ../stylesheets .css
//= link_tree ../../javascript .js
//= link_tree ../../../vendor/javascript .js</code></pre>
              </div>

              <h5 class="mt-4 mb-3">Install and Setup</h5>
              <p class="card-text mb-3">Install gem and run required tasks:</p>
              <div class="bg-dark p-3 rounded mb-4">
                <pre class="text-light mb-0"><code>$ bundle
$ rails active_storage:install
$ rails lato:install:application
$ rails lato:install:migrations
$ rails db:migrate</code></pre>
              </div>

              <h5 class="mt-4 mb-3">Configure Routes</h5>
              <p class="card-text mb-3">Mount lato routes on the <strong>config/routes.rb</strong> file:</p>
              <div class="bg-dark p-3 rounded mb-4">
                <pre class="text-light mb-0"><code>Rails.application.routes.draw do
  mount Lato::Engine => "/lato"

  # ....
end</code></pre>
              </div>

              <h5 class="mt-4 mb-3">Import Styles</h5>
              <p class="card-text mb-3">Import Lato Scss on <strong>app/assets/stylesheets/application.scss</strong> file:</p>
              <div class="bg-dark p-3 rounded mb-4">
                <pre class="text-light mb-0"><code>@import 'lato/application';

// ....</code></pre>
              </div>

              <h5 class="mt-4 mb-3">Import JavaScript</h5>
              <p class="card-text mb-3">Import Lato Js on <strong>app/javascript/application.js</strong> file:</p>
              <div class="bg-dark p-3 rounded mb-4">
                <pre class="text-light mb-0"><code>import "lato/application";

// ....</code></pre>
              </div>

              <h5 class="mt-4 mb-3">Setup I18n</h5>
              <p class="card-text mb-3">Setup I18n on the <strong>config/application.rb</strong> file:</p>
              <div class="bg-dark p-3 rounded mb-4">
                <pre class="text-light mb-0"><code>module MyApplication
  class Application < Rails::Application
    config.i18n.available_locales = [:it, :en]
    config.i18n.default_locale = :it

    # ...
  end
end</code></pre>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Final CTA -->
      <div class="text-center pb-5 llm-ignore">
        <h2 class="h3 mb-4">Ready to build better panels, faster?</h2>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
          <%= link_to 'Get started with the tutorial', tutorial_path, class: 'btn btn-light btn-lg px-5 fw-semibold' %>
          <a class="btn btn-outline-light btn-lg px-5" href="https://github.com/Lato-org/lato">Explore the code</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .text-gradient-primary {
    background: linear-gradient(90deg, #4cc9f0, #4361ee);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .homepage-landing .hero-badge {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .homepage-landing .hero-badge-dot {
    width: 8px;
    height: 8px;
    background: #4cc9f0;
    display: inline-block;
  }

  .homepage-landing .glass-card {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
  }
  .homepage-landing .glass-card-link {
    transition: transform .25s ease, background .25s ease;
  }
  .homepage-landing .glass-card-link:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.12);
  }

  .homepage-landing .screenshot-frame {
    max-width: 960px;
    border-radius: .75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.6);
  }
  .homepage-landing .browser-bar {
    background: rgba(255, 255, 255, 0.08);
  }
  .homepage-landing .browser-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
</style>

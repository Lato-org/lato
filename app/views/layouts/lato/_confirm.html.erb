<div class="lato-confirm modal fade" data-controller="lato-confirm" tabindex="-1" aria-hidden="true" aria-labelledby="latoConfirmTitle">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="mb-0 mt-0 fs-4" id="latoConfirmTitle"><%= I18n.t('lato.confirm_title') %></h2>
        <button type="button" class="btn-close" data-action="click->lato-confirm#confirmCancel" aria-label="<%= I18n.t('lato.close') %>"></button>
      </div>
      <div class="modal-body" data-lato-confirm-target="modalBody">
      </div>
      <div class="modal-footer">
        <button
          type="button"
          class="btn btn-secondary"
          data-action="click->lato-confirm#confirmCancel"
        ><%= I18n.t('lato.confirm_no') %></button>
        <button
          type="button"
          class="btn btn-primary"
          data-action="click->lato-confirm#confirmSuccess"
        ><%= I18n.t('lato.confirm_yes') %></button>
      </div>
    </div>
  </div>
</div>
